{
  "name": "kong-browser",
  "productName": "Kong Browser",
  "version": "0.0.1-beta",
  "private": true,
  "description": "커뮤니티 화면을 통일해서 보여주는 브라우저",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsx scripts/build.mts",
    "start": "tsx scripts/build.mts && electron .",
    "dist": "tsx scripts/build.mts && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx scripts/build.mts && tsx scripts/e2e.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "tsx scripts/build.mts && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.kong.browser",
    "productName": "Kong Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/recipes",
        "to": "recipes"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "KongBrowser-${version}-Setup.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs",
    "portable": {
      "artifactName": "KongBrowser-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "KongBrowser-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "KongBrowser-${version}-mac-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
