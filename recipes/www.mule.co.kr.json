{
  "schemaVersion": 2,
  "host": "www.mule.co.kr",
  "version": 5,
  "minEngine": 1,
  "siteName": "뮬",
  "account": {
    "sel": [
      "#header .header-icon"
    ],
    "exclude": [
      ".l-darkmode",
      ".alarm",
      "img",
      "br",
      ".pushcount"
    ]
  },
  "waitFor": 2000,
  "overlays": [
    "#modal",
    ".pswp",
    "#side"
  ],
  "menu": [
    {
      "label": "뮬 메뉴",
      "groups": [
        "#header .header-bottom"
      ],
      "links": [
        "ul a[href]"
      ],
      "current": "prefix",
      "style": "chips"
    },
    {
      "groups": [],
      "links": [],
      "current": "prefix",
      "fixed": [
        {
          "title": "악기장터",
          "href": "/bbs/market",
          "links": [
            {
              "text": "뮬 악기장터",
              "href": "/bbs/market/sell"
            },
            {
              "text": "레코딩",
              "href": "/bbs/market/sell?&ct1=%EB%A0%88%EC%BD%94%EB%94%A9/PA/%ED%82%A4%EB%B3%B4%EB%93%9C"
            },
            {
              "text": "삽니다",
              "href": "/bbs/market/buy"
            },
            {
              "text": "거래후기",
              "href": "/bbs/market/review"
            }
          ]
        },
        {
          "title": "뮬人/게시판",
          "href": "/bbs/community/muleins",
          "links": [
            {
              "text": "뮬보드",
              "href": "/bbs/community/muleboard"
            },
            {
              "text": "뮬인",
              "href": "/bbs/community/mulein"
            },
            {
              "text": "갤러리",
              "href": "/bbs/community/gallery"
            },
            {
              "text": "감정갤",
              "href": "/bbs/community/custom"
            },
            {
              "text": "베이스",
              "href": "/bbs/community/base"
            },
            {
              "text": "정사종/격리",
              "href": "/bbs/community/politics"
            },
            {
              "text": "뮬메모판",
              "href": "/page/chat"
            }
          ]
        }
      ]
    }
  ],
  "side": [
    {
      "links": {
        "groups": [
          ".mule-latest-bbs-wrapper"
        ],
        "heading": {
          "sel": [
            ".title",
            "h2"
          ]
        },
        "links": [
          "a[href*='idx=']"
        ],
        "current": "none"
      }
    }
  ],
  "pages": [
    {
      "id": "post",
      "type": "post",
      "match": "[?&]idx=[0-9]+",
      "probe": [
        "#board .body-wrapper-board > h2",
        "#bbsContent"
      ],
      "title": {
        "sel": [
          "#board .body-wrapper-board > h2"
        ],
        "required": true
      },
      "author": {
        "sel": [
          "#board .body-wrapper-board .info-box li a"
        ]
      },
      "createdAt": {
        "sel": [
          "#board .body-wrapper-board .info-box li small"
        ],
        "text": "^\\d{4}-\\d{2}-\\d{2}"
      },
      "info": {
        "sel": [
          "#board .body-wrapper-board > .category-box"
        ],
        "keepStyle": true
      },
      "body": {
        "sel": [
          "#bbsContent"
        ],
        "required": true
      },
      "comments": {
        "anchor": "#comment-top",
        "lazy": true,
        "item": [
          "#comment-top .comment-item:not(.premium-bg)"
        ],
        "bestItem": [
          "#comment-top .comment-item.premium-bg"
        ],
        "replyMarker": ".reply",
        "depth": {
          "attr": "style",
          "pattern": "padding-left:\\s*([0-9]+)px",
          "step": 20,
          "base": 20
        },
        "who": {
          "sel": [
            ".namecard"
          ]
        },
        "whoNode": {
          "sel": [
            ".namecard"
          ]
        },
        "when": {
          "sel": [
            ".regdt"
          ]
        },
        "content": {
          "sel": [
            ".comment-message",
            ".message"
          ],
          "required": true
        },
        "actions": {
          "sel": [
            ".comment-content-box > .button-box:last-of-type"
          ]
        },
        "replyWrite": {
          "sel": [
            "#comment-top .comment-item .write-group"
          ],
          "keepStyle": true
        }
      },
      "commentWrite": {
        "sel": [
          "#comment-top > .write-group"
        ],
        "keepStyle": true
      }
    },
    {
      "id": "market-home",
      "type": "hub",
      "match": "^/bbs/market/?(\\?.*)?$",
      "probe": [
        ".gallery-list-wrapper a.gallery-item"
      ],
      "title": {
        "sel": [
          "head > title"
        ],
        "pattern": "^(.+?)\\s*\\|"
      },
      "blocks": {
        "sel": [
          "#board .gallery-list-wrapper"
        ],
        "keepStyle": true
      }
    },
    {
      "id": "list",
      "type": "board",
      "match": "^/(bbs|best)/(?!.*[?&](v=w|mode=gallery)(&|$))",
      "probe": [
        ".board-list-wrapper table td.title a"
      ],
      "boardName": {
        "sel": [
          "head > title"
        ],
        "pattern": "^(.+?)\\s*\\|"
      },
      "rows": {
        "scope": [
          ".board-list-wrapper table"
        ],
        "item": [
          "tbody tr"
        ],
        "notice": ".notice",
        "category": {
          "sel": [
            "td.category"
          ]
        },
        "title": {
          "sel": [
            "td.title > a"
          ],
          "exclude": [
            ".mobile",
            ".pc",
            ".badge-icon",
            "span.color-red",
            "span.color-blue"
          ]
        },
        "link": {
          "sel": [
            "td.title > a"
          ]
        },
        "author": {
          "sel": [
            "td.writer"
          ]
        },
        "createdAt": {
          "sel": [
            "td.regdt"
          ]
        },
        "views": {
          "sel": [
            "td.view"
          ]
        },
        "likes": {
          "sel": [
            "td.good"
          ]
        },
        "commentCount": {
          "sel": [
            "td.title .pc",
            "td.title > a > span.color-red",
            "td.title > a > span.color-blue"
          ],
          "pattern": "([0-9]+)"
        },
        "image": "td.option img[src$=\"p.png\"]",
        "video": ".badge-youtube",
        "thumbnail": {
          "sel": [
            "td.option img.preview-img"
          ],
          "attr": "data-src"
        },
        "extras": [
          {
            "sel": [
              "td.price"
            ]
          },
          {
            "sel": [
              "td.region"
            ]
          }
        ],
        "visitPattern": "[?&]idx=([0-9]+)",
        "gallery": true
      },
      "pager": {
        "sel": [
          "#board .paging-box"
        ]
      },
      "search": {
        "sel": [
          "#board .search-wrapper"
        ],
        "keepStyle": true
      },
      "write": {
        "sel": [
          "#board #bt-write"
        ]
      }
    },
    {
      "id": "home",
      "type": "hub",
      "match": "^/?(\\?.*)?$",
      "probe": [
        "#section-main"
      ],
      "blocks": {
        "sel": [
          "#section-main .mule-today, #section-main .gallery-wrapper, #section-main .latest-gallery-wrapper"
        ],
        "keepStyle": true
      }
    }
  ]
}
