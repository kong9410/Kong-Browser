{
  "schemaVersion": 2,
  "host": "gall.dcinside.com",
  "version": 21,
  "minEngine": 1,
  "siteName": "디시인사이드",
  "logo": {
    "sel": [
      "header.dcheader h1.dclogo a.logo_img"
    ]
  },
  "account": {
    "sel": [
      "header.dcheader .dchead .area_links"
    ],
    "keepStyle": true
  },
  "menu": [
    {
      "label": "디시 메뉴",
      "groups": [
        "nav.gnb ul.gnb_list"
      ],
      "links": [
        ":scope > li > a.link_gnb"
      ],
      "current": "mark",
      "mark": ".on",
      "style": "chips",
      "skip": "광고"
    },
    {
      "label": "최근 방문 갤러리",
      "groups": [
        ".newvisit_history .vst_listbox"
      ],
      "links": [
        "li > a"
      ]
    }
  ],
  "side": [
    {
      "move": {
        "sel": [
          "#login_box"
        ],
        "keepStyle": true
      }
    },
    {
      "title": "게시물",
      "move": {
        "sel": [
          ".list_array_option .array_tab"
        ]
      }
    },
    {
      "title": "말머리",
      "move": {
        "sel": [
          ".list_array_option .center_box"
        ]
      },
      "reveal": [
        ".subject_morelist"
      ],
      "hide": [
        ".btn_subject_more"
      ]
    },
    {
      "links": {
        "groups": [
          "#bottom_listwrap"
        ],
        "label": "글 목록",
        "links": [
          "tr.ub-content td.gall_tit > a:first-child:not(:has(.icon_n_survey, .icon_ad, .icon_notice))"
        ],
        "current": "mark",
        "mark": "[class*=crt]"
      }
    },
    {
      "move": {
        "sel": [
          "#bottom_listwrap .bottom_paging_box"
        ]
      }
    }
  ],
  "pages": [
    {
      "id": "post",
      "type": "post",
      "match": "^/(mgallery/|mini/)?board/view/",
      "probe": [
        ".gallview_head",
        ".write_div"
      ],
      "category": {
        "sel": [
          ".gallview_head .title_headtext"
        ]
      },
      "title": {
        "sel": [
          ".gallview_head .title_subject"
        ],
        "required": true
      },
      "author": {
        "sel": [
          ".gallview_head .gall_writer"
        ],
        "attr": "data-nick"
      },
      "createdAt": {
        "sel": [
          ".gallview_head .gall_date"
        ]
      },
      "views": {
        "sel": [
          ".gallview_head .gall_count"
        ],
        "pattern": "([0-9,]+)"
      },
      "likes": {
        "sel": [
          ".gallview_head .gall_reply_num"
        ],
        "pattern": "([0-9,]+)"
      },
      "body": {
        "sel": [
          ".writing_view_box .write_div"
        ],
        "required": true
      },
      "actions": {
        "sel": [
          ".btn_recommend_box"
        ]
      },
      "listLink": {
        "sel": [
          ".view_bottom_btnbox button"
        ],
        "text": "^(전체글|목록)$"
      },
      "commentCount": {
        "sel": [
          "[id^=comment_total_]"
        ]
      },
      "comments": {
        "lazy": true,
        "item": [
          ".comment_box li.ub-content:not(.dory):not([id^=img_comment_li_])"
        ],
        "replyMarker": "[id^=reply_li_]",
        "who": {
          "sel": [
            ".gall_writer"
          ],
          "attr": "data-nick"
        },
        "when": {
          "sel": [
            ".date_time"
          ]
        },
        "content": {
          "sel": [
            ".cmt_txtbox",
            ".del_reply"
          ],
          "required": true,
          "raw": [
            ".comment_dccon"
          ],
          "context": true
        },
        "more": {
          "sel": [
            ".cmt_paging"
          ]
        },
        "whoNode": {
          "sel": [
            ".cmt_nickbox .gall_writer",
            ".gall_writer"
          ],
          "raw": [
            ".writer_nikcon",
            ".ip",
            "[class*=icon]"
          ]
        },
        "replyWrite": {
          "sel": [
            ".comment_box .cmt_write_box.small"
          ],
          "keepStyle": true
        }
      },
      "fit": {
        "row": [
          ".img_comment .addbox"
        ],
        "fill": [
          ".img_comment .cmt_txtbox",
          ":is(.k-cmt-write, .k-reply-write) .cmt_write_box .cmt_txt_cont"
        ],
        "full": [
          ":is(.k-cmt-write, .k-reply-write) .cmt_write_box .cmt_write",
          ":is(.k-cmt-write, .k-reply-write) .cmt_write_box .cmt_write textarea",
          ":is(.k-cmt-write, .k-reply-write) .cmt_write_box .cmt_cont_bottm"
        ]
      },
      "write": {
        "sel": [
          ".view_bottom_btnbox button.write"
        ]
      },
      "commentWrite": {
        "sel": [
          "#focus_cmt > .cmt_write_box",
          ".view_comment > .cmt_write_box:not([id^=img_cmt_write_box_])"
        ],
        "keepStyle": true
      }
    },
    {
      "id": "board",
      "type": "board",
      "match": "^/(mgallery/|mini/)?board/lists",
      "probe": [
        ".gall_listwrap table.gall_list"
      ],
      "boardName": {
        "sel": [
          ".page_head h2 a",
          ".page_head h2"
        ],
        "exclude": [
          ".pagehead_titicon",
          ".blind"
        ]
      },
      "rows": {
        "sameBoard": "[?&]id=([^&]+)",
        "scope": [
          ".gall_listwrap table.gall_list"
        ],
        "item": [
          "tr.ub-content.us-post, tr.ub-content[data-type=icon_notice]"
        ],
        "notice": "[data-type=icon_notice]",
        "title": {
          "sel": [
            ".gall_tit > a:first-child"
          ]
        },
        "link": {
          "sel": [
            ".gall_tit > a:first-child"
          ]
        },
        "category": {
          "sel": [
            ".gall_subject"
          ]
        },
        "author": {
          "sel": [
            ".gall_writer"
          ],
          "attr": "data-nick"
        },
        "createdAt": {
          "sel": [
            ".gall_date"
          ]
        },
        "views": {
          "sel": [
            ".gall_count"
          ]
        },
        "likes": {
          "sel": [
            ".gall_recommend"
          ]
        },
        "commentCount": {
          "sel": [
            ".reply_num"
          ]
        },
        "image": "[data-type=icon_pic], [data-type=icon_recomimg]",
        "video": "[data-type=icon_movie], [data-type=icon_recomovie]",
        "thumbnail": {
          "sel": [
            ".gall_tit .thumimg img"
          ]
        },
        "visitParams": [
          "id",
          "no"
        ]
      },
      "pager": {
        "sel": [
          ".bottom_paging_box"
        ]
      },
      "search": {
        "sel": [
          "form[name=frmSearch]"
        ],
        "exclude": [
          ".select_area",
          ".option_box"
        ]
      },
      "write": {
        "sel": [
          ".list_bottom_btnbox button.write",
          ".switch_btnbox a.btn_write"
        ]
      }
    },
    {
      "id": "write",
      "type": "hub",
      "match": "^/(mgallery/|mini/)?board/write/",
      "probe": [
        "#write_wrap"
      ],
      "title": {
        "sel": [
          "head > title"
        ]
      },
      "blocks": {
        "sel": [
          "#write_wrap"
        ],
        "keepStyle": true
      },
      "fit": {
        "tight": [
          "#write_wrap"
        ],
        "full": [
          "#write_wrap form",
          "#write_wrap fieldset",
          "#write_wrap .input_write_tit",
          "#write_wrap #subject",
          "#write_wrap .note-editor"
        ],
        "static": [
          "#write_wrap .note-toolbar .note-mybutton:has(#chk_html)"
        ],
        "right": [
          {
            "sel": "#write_wrap .note-mybutton .note-btn:has(#chk_html)",
            "px": 56
          }
        ]
      }
    }
  ]
}
